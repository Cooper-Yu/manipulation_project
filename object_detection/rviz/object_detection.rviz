Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: base_link
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Raw PointCloud2
      Topic: /wrist_rgbd_depth_sensor/points
      Style: Points
      Size (Pixels): 4
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Surface Markers
      Topic: /surface_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Object Markers
      Topic: /object_markers
  Global Options:
    Fixed Frame: base_link
  Name: root

Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 1.5
    Focal Point:
      X: 0.45
      Y: 0.0
      Z: 0.25
    Pitch: 0.6
    Yaw: 0.8
